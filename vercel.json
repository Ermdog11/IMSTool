{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/scan.js": {
      "maxDuration": 300
    },
    "api/copyedit.js": {
      "maxDuration": 120
    },
    "api/style-profile.js": {
      "maxDuration": 120
    },
    "api/podcasts.js": {
      "maxDuration": 60
    },
    "api/transcripts.js": {
      "maxDuration": 120
    },
    "api/digest.js": {
      "maxDuration": 300
    },
    "api/morning-brief.js": {
      "maxDuration": 300
    },
    "api/rolling-digest.js": {
      "maxDuration": 300
    },
    "api/roster-check.js": {
      "maxDuration": 60
    },
    "api/coverage-desk.js": {
      "maxDuration": 300
    },
    "api/submit-article.js": {
      "maxDuration": 60
    },
    "api/drafts.js": {
      "maxDuration": 30
    },
    "api/roster-view.js": {
      "maxDuration": 30
    },
    "api/analytics-connections.js": {
      "maxDuration": 20
    },
    "api/chartbeat.js": {
      "maxDuration": 20
    },
    "api/publish-watch.js": {
      "maxDuration": 120
    },
    "api/scrape-session.js": {
      "maxDuration": 20
    },
    "api/dev-digest.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/:section(alerts|digest|social|chat|backlog|recruiting|trending|podcasts|youtube|bluesky|settings|analytics|roster)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/:section(alerts|digest|social|chat|backlog|recruiting|trending|podcasts|youtube|bluesky|settings|analytics|roster|editor|login)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "crons": [
    {
      "path": "/api/rolling-digest?slot=morning",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/rolling-digest?slot=midday",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/rolling-digest?slot=evening",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/roster-check",
      "schedule": "30 11 * * 1,3,5"
    },
    {
      "path": "/api/coverage-desk",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/publish-watch",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/dev-digest",
      "schedule": "0 13 * * *"
    }
  ]
}
