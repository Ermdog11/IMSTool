  "rewrites": [
    { "source": "/:section(alerts|digest|social|chat|backlog|recruiting|trending|podcasts|youtube|bluesky|settings|analytics|roster|opps|calendar)", "destination": "/" },
    { "source": "/house-style", "destination": "/editor" },
    { "source": "/transcribe", "destination": "/editor" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/:section(alerts|digest|social|chat|backlog|recruiting|trending|podcasts|youtube|bluesky|settings|analytics|roster|opps|calendar|editor|login|house-style|setup|transcribe|preferences|affiliates)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    }
  ],
  "crons": [
    {
      "path": "/api/email-drafts",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/opps-spy?run=1",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/rolling-digest?slot=morning",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/rolling-digest?slot=midday",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/rolling-digest?slot=evening",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/roster-check?scope=teams",
      "schedule": "30 11 * * 1,3,5"
    },
    {
      "path": "/api/roster-check?scope=department",
      "schedule": "40 11 * * 1,3,5"
    },
    {
      "path": "/api/heat-spots",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/coverage-desk",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/publish-watch",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/dev-digest",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/analytics-snapshot",
      "schedule": "0 */3 * * *"
    },
    {
      "path": "/api/hot-story-check",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/social-promo-check",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/x-scan",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/records-suggest",
      "schedule": "20 */2 * * *"
    }
  ]
}
